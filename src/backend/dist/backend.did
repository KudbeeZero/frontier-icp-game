type UpgradeError = 
 variant {
   AlreadyMaxTier;
   InsufficientFRNTR;
   InvalidTier;
   NotOwner;
   PlotNotFound;
   SubParcelLocked;
 };
type Tokenomics = 
 record {
   burnRate: nat;
   circulatingSupply: nat;
   daysUntilMilestone: nat;
   emissionRate: nat;
   maxSupply: nat;
   remainingMineable: nat;
   totalBurned: nat;
 };
type Timestamp = int;
type SurveyView = 
 record {
   plotId: PlotId;
   result: opt SurveyResult;
   secondsRemaining: nat;
   startTime: int;
   status: SurveyStatus;
   unlockCost: nat;
 };
type SurveyStatus = 
 variant {
   Completed;
   InProgress;
   Locked;
 };
type SurveyResult = 
 record {
   biome: Biome;
   bonusInfo: opt text;
   resourcePercentage: nat;
 };
type SubParcelInfo = 
 record {
   buildingType: text;
   cooldownSecondsRemaining: nat;
   isLocked: bool;
   resourceRate: float64;
   slotIndex: nat;
 };
type SubParcel = 
 record {
   building: opt text;
   cooldownEnds: int;
   plotId: text;
   slotIndex: nat;
   specialization: text;
   subParcelId: text;
 };
type StressTestResult = 
 variant {
   err: text;
   ok: vec StressActionResult;
 };
type StressActionResult = 
 record {
   action: text;
   durationMs: int;
   errorMsg: opt text;
   index: nat;
   ok: bool;
 };
type Result = 
 variant {
   err: text;
   ok: nat;
 };
type ResourceType = 
 variant {
   Crystal;
   Fuel;
   Iron;
   RareEarth;
 };
type ResetResult = 
 variant {
   err: text;
   ok: text;
 };
type PrincipalDisplay = 
 record {
   full: text;
   isAuthed: bool;
   short: text;
 };
type PlotUpgradesView = 
 record {
   bonusPerDay: float64;
   generatorTier: GeneratorTier;
   installedAt: opt Timestamp;
   nextTierCost: opt nat;
   plotId: PlotId;
   tierName: text;
 };
type PlotProductionRate = 
 record {
   baseFRNTRPerDay: float64;
   generatorTier: nat;
   nexusBonus: float64;
   plotId: text;
   tierBonus: float64;
   totalPerDay: float64;
 };
type PlotId = text;
type MissionRequirementKind = 
 variant {
   claimTokens: nat;
   holdFRNTR: nat;
   purchasePlots: nat;
   reachLeaderboardTop: nat;
   surveyPlot;
   upgradeToTier: nat;
 };
type Mission = 
 record {
   description: text;
   id: text;
   requirement: MissionRequirementKind;
   rewardE8s: nat;
   title: text;
 };
type MineResult = 
 record {
   efficiency: float64;
   frntRate: float64;
   plotId: PlotId;
   resourceYields: vec record {
                         ResourceType;
                         float64;
                       };
 };
type GlobalStats = 
 record {
   activePlayers: nat;
   circulatingSupply: nat;
   dailyEmission: nat;
   totalBurned: nat;
   totalPlotsOwned: nat;
 };
type GeneratorTierInfo = 
 record {
   bonusPerDay: float64;
   costFRNTR: nat;
   name: text;
   tierIndex: nat;
 };
type GeneratorTier = 
 variant {
   None;
   TierI;
   TierII;
   TierIII;
   TierIV;
   TierV;
   TierVI;
 };
type FaucetResult = 
 variant {
   err: text;
   ok: FaucetGrant;
 };
type FaucetGrant = 
 record {
   frntGranted: nat;
   icpGranted: nat;
 };
type FaucetClaimSummary = 
 record {
   lastClaim: opt int;
   "principal": text;
   totalClaims: nat;
 };
type CombatEvent = 
 record {
   atkPower: nat;
   attacker: principal;
   defPower: nat;
   fromPlot: text;
   intercepted: bool;
   interceptorType: opt text;
   missileType: opt text;
   success: bool;
   timestamp: int;
   toPlot: text;
 };
type Biome = 
 variant {
   Arctic;
   AsteroidImpact;
   DeepOcean;
   Desert;
   Ocean;
   Temperate;
   Tropical;
   Volcanic;
 };
type ActionAuditEntry = 
 record {
   action: text;
   amount: opt nat;
   caller: principal;
   decision: text;
   details: text;
   plotId: opt text;
   tier: opt text;
   timestamp: int;
 };
service : {
  assignInterceptor: (plotId: text, interceptorType: text) -> ();
  /// Compute how much FRNTR has accrued for the caller since their lastClaimTime,
  /// transfer it from the game canister to the caller's principal via ICRC-1,
  /// update lastClaimTime to now, and return the claimed amount (in e8s) or an error.
  /// Claim accumulated FRNTR tokens for a specific plot.
  /// Accrual = (now - lastClaimTime) / 86400s * dailyRate.
  /// Mints fresh tokens via icrc1_transfer from game canister (minting account).
  claimAccumulatedTokens: (plotId: text) -> (variant {
                                               err: text;
                                               ok: nat;
                                             });
  /// Claim accumulated FRNTR tokens for ALL plots owned by the caller.
  /// Mints fresh tokens via icrc1_transfer from game canister (minting account).
  claimAllPlots: () ->
   (variant {
      err: text;
      ok: record {
            amount: nat;
            plotsClaimed: nat;
          };
    });
  /// Thin wrapper around completeSurvey — returns the SurveyResult report alongside the
  /// token award so the frontend can display both in a single call.
  /// Returns #err if the survey timer is not yet complete or no survey exists.
  /// Thin wrapper around completeSurvey — returns the SurveyResult report alongside the
  /// token award so the frontend can display both in a single call.
  /// Returns #err if the survey timer is not yet complete or no survey exists.
  claimSurveyReward: (plotId: text) ->
   (variant {
      err: text;
      ok: record {
            report: SurveyResult;
            rewardE8s: nat;
          };
    });
  /// Complete a mission. Verifies requirement, mints reward, marks done.
  completeMission: (missionId: text) -> (variant {
                                           err: text;
                                           ok: nat;
                                         });
  /// Complete a survey that has finished its timer and mint the token award to the caller.
  /// Returns #ok(awardE8s) on success or #err(message) on failure.
  completeSurvey: (plotId: text) -> (Result);
  getAdjacentPlots: (plotId: text) -> (vec text) query;
  getAdminPrincipal: () -> (text) query;
  /// Returns all plots that have an owner as (plotId, ownerPrincipalText) pairs.
  getAllPlotOwners: () -> (vec record {
                                 text;
                                 text;
                               }) query;
  /// Returns the currently approved DEX canister principal for liquidity withdrawals.
  /// Set via setApprovedLiquidityCanister (admin only).
  getApprovedLiquidityCanister: () -> (opt text) query;
  getAssignedInterceptor: (plotId: text) -> (opt text) query;
  /// Returns the total number of entries in the audit log. Public — no auth required.
  getAuditLogCount: () -> (nat) query;
  /// Returns all audit log entries for a given principal.
  /// Only the principal themselves or the admin may query this.
  getAuditLogForPrincipal: ("principal": principal) ->
   (variant {
      err: text;
      ok: vec record {
                int;
                ActionAuditEntry;
              };
    }) query;
  getCombatLog: (limit: nat) -> (vec CombatEvent) query;
  getCoreGeneratorTiers: () -> (vec GeneratorTierInfo) query;
  /// Returns total faucet claims for a principal (debug/analytics).
  getFaucetClaims: ("principal": principal) -> (FaucetClaimSummary) query;
  /// Returns the first plot ID with no owner, or null if all plots are owned.
  /// Used by the stress-test to find a purchasable plot without hardcoding an ID.
  getFirstAvailablePlot: () -> (opt text) query;
  getFrntrLedger: () -> (text) query;
  /// Returns the full audit log. Admin only.
  getFullAuditLog: () ->
   (variant {
      err: text;
      ok: vec record {
                int;
                ActionAuditEntry;
              };
    }) query;
  getGameCanisterPrincipal: () -> (text) query;
  /// Live global game stats for the UNIVERSE panel (v2 — detailed fields).
  /// totalSupply = 10B hard cap (in e8s); remainingMineable = 5B mineable cap minus total burned.
  getGameStats: () ->
   (record {
      emissionRatePerDay: nat;
      globalUnclaimedTokens: nat;
      remainingMineable: nat;
      totalActionCount: nat;
      totalBurned: nat;
      totalDailyOutput: nat;
      totalFrntrBurned: nat;
      totalPlayers: nat;
      totalPlots: nat;
      totalSupply: nat;
    }) query;
  /// Returns the canonical generator tier catalog for all tiers.
  /// Frontend uses this so tier data is never hardcoded.
  getGeneratorTierCatalog: () ->
   (vec record {
          bonusPerDay: float64;
          cost: nat;
          tierIndex: nat;
        }) query;
  getGlobalStats: () -> (GlobalStats) query;
  /// Total global unclaimed tokens in e8s sitting on all owned plots.
  getGlobalUnclaimedTokens: () -> (nat) query;
  getIcpBalance: ("principal": principal) -> (nat);
  /// ICP/USD price oracle — performs HTTP outcall to CoinGecko API with 60s cache.
  /// URL: https://api.coingecko.com/api/v3/simple/price?ids=internet-computer&vs_currencies=usd
  /// Returns the current ICP/USD price as a Float.
  getIcpUsdPrice: () -> (float64);
  /// Returns the cached ICP/USD price without an HTTP outcall.
  /// Returns 0.0 if the price has never been fetched.
  getIcpUsdPriceCached: () -> (float64) query;
  /// Returns true if the caller is the current admin principal.
  getIsAdmin: () -> (bool) query;
  /// Public leaderboard query: top players by FRNTR balance.
  getLeaderboard: (limit: nat) ->
   (vec
     record {
       frntBalance: nat;
       plotsOwned: nat;
       "principal": text;
       rank: nat;
       username: opt text;
     }) query;
  /// Returns global leaderboard and economy stats.
  getLeaderboardStats: () ->
   (record {
      activePlayers: nat;
      leaderboardPrizePool: nat;
      nextPayoutAt: nat;
      totalFRNTRBurned: nat;
      totalFRNTRMined: nat;
      totalPlotsOwned: nat;
    }) query;
  /// Returns all owned plots as (plotId, ownerPrincipalText) pairs.
  /// Alias used by frontend for globe ownership sync.
  getLivePlotOwners: () -> (vec record {
                                  text;
                                  text;
                                }) query;
  /// Returns the full mission list.
  getMissions: () -> (vec Mission) query;
  /// Returns the calling player's own audit log (most-recent-first, capped at 500 entries).
  /// No arguments required — identity is taken from the caller's principal.
  getMyAuditLog: () -> (vec record {
                              int;
                              ActionAuditEntry;
                            }) query;
  getPassiveIncome: (plotId: text) -> (float64) query;
  /// Returns each mission with the caller's completion status.
  getPlayerMissions: () ->
   (vec record {
          completed: bool;
          mission: Mission;
        }) query;
  getPlayerState: () ->
   (record {
      combatVictories: nat;
      crystal: nat;
      frntBalance: nat;
      fuel: nat;
      generatorTiersMap: vec record {
                               text;
                               nat;
                             };
      icpBalance: nat;
      iron: nat;
      lastFaucetTime: opt int;
      ownedPlots: vec text;
      passiveIncomePerDay: float64;
      plotIds: vec text;
      plotsOwned: nat;
      resourceBalances: vec record {
                              ResourceType;
                              float64;
                            };
      totalFRNTRBurned: float64;
      username: opt text;
    });
  /// Query the full player state for a given principal.
  /// Returns a zeroed state if the principal has not played yet.
  /// Uses live ICRC-1 ledger balance when frntrLedger is configured.
  getPlayerStateByPrincipal: ("principal": principal) ->
   (record {
      combatVictories: nat;
      crystal: nat;
      frntBalance: nat;
      fuel: nat;
      generatorTiersMap: vec record {
                               text;
                               nat;
                             };
      icpBalance: nat;
      iron: nat;
      lastFaucetTime: opt int;
      ownedPlots: vec text;
      passiveIncomePerDay: float64;
      plotIds: vec text;
      plotsOwned: nat;
      resourceBalances: vec record {
                              ResourceType;
                              float64;
                            };
      totalFRNTRBurned: float64;
      username: opt text;
    });
  /// Returns the total number of plots currently stored.
  getPlotCount: () -> (nat) query;
  /// Returns the canonical ICP price (e8s) for a plot identified by its H3 index.
  getPlotPrice: (h3Index: text) -> (nat) query;
  /// Returns the ICP price in e8s for a plot identified by its H3 Text ID.
  /// Price tier is derived from biome richness stored in the plots map.
  getPlotPriceById: (plotId: text) -> (nat) query;
  getPlotProductionRate: (plotId: text) -> (PlotProductionRate) query;
  /// Returns all plot IDs owned by a given principal.
  getPlotsByOwner: (owner: principal) -> (vec text) query;
  /// Returns the caller's principal display info for wallet/identity UI.
  getPrincipal: () -> (PrincipalDisplay) query;
  /// Returns 7 SubParcelInfo entries (slots 0-6) for a plot.
  /// isLocked = true during the 4-hour post-purchase cooldown.
  /// cooldownSecondsRemaining = 0 when not locked.
  /// Sub-parcel ID = plotId # ":" # slotIndex.
  getSubParcelStatus: (plotId: text) -> (vec SubParcelInfo) query;
  /// Returns all 7 sub-parcels for a given plot ID.
  getSubParcels: (plotId: text) -> (vec SubParcel) query;
  /// Returns the survey cost (in FRNTR e8s) for a given plot.
  getSurveyCost: (plotId: text) -> (nat) query;
  /// Get the completed survey result for a plot.
  /// Returns #err if the survey has not been started or the timer hasn't expired.
  getSurveyResult: (plotId: text) -> (variant {
                                        err: text;
                                        ok: SurveyResult;
                                      });
  /// Get the current survey status for a plot.
  /// If the timer has expired the result is auto-computed and the survey is
  /// promoted to #Completed — the updated record is persisted.
  getSurveyStatus: (plotId: text) -> (variant {
                                        err: text;
                                        ok: SurveyView;
                                      });
  getTokenomics: () -> (Tokenomics) query;
  /// Returns the total amount of FRNTR burned across all game actions.
  getTotalBurned: () -> (nat) query;
  /// Total global daily output in e8s across all owned plots.
  getTotalGlobalDailyOutput: () -> (nat) query;
  getTreasuryBalances: () ->
   (record {
      devPot: nat;
      leaderboardPot: nat;
      liquidityPot: nat;
    });
  /// Query the current treasury canister principal.
  getTreasuryPrincipal: () -> (text) query;
  /// Returns current balances of the three treasury pots in e8s.
  /// devPot: 25% of plot ICP; leaderboardPot: 25%; liquidityPot: 50%.
  /// getTreasuryState: alias for getTreasuryBalances, returns the 25/25/50 split balances.
  /// Shape: { developer: Nat; leaderboard: Nat; liquidity: Nat } (all in e8s).
  getTreasuryState: () ->
   (record {
      developer: nat;
      leaderboard: nat;
      liquidity: nat;
    }) query;
  /// Seed plots from the frontend (admin only). Skips plots that already exist.
  /// Also creates 7 sub-parcels per plot (slot 0 = center Nexus, slots 1-6 = surrounding).
  initPlots: (plotData: vec record {
                              text;
                              text;
                              float64;
                              float64;
                              nat;
                            }) -> ();
  isSubParcelLocked: (plotId: text) -> (bool) query;
  launchMissile: (fromPlotId: text, toPlotId: text, missileType: text) ->
   (variant {
      err: text;
      ok: text;
    });
  /// Returns the caller's real ICP balance from the on-chain ICP ledger (ryjl3-tyaaa-aaaaa-aaaba-cai).
  /// Result is in raw e8s (divide by 100_000_000 for ICP display).
  /// Log a cancellation decision. Called by the frontend when the player clicks
  /// "Cancel" on a confirmation modal — BEFORE any canister call is made.
  /// Records the caller's wallet address, action type, and timestamp on-chain.
  logCancelledAction: (action: text, plotId: opt text, amount: opt nat,
   details: text) -> ();
  /// Mine resources from an owned plot.
  /// DISABLED: returns an informative error until the mining system launches.
  mineResources: (_plotId: text) -> (variant {
                                       err: text;
                                       ok: MineResult;
                                     });
  purchasePlot: (plotId: text) -> (variant {
                                     err: text;
                                     ok: text;
                                   });
  /// Admin: wipe all game state (plots, players, usernames, faucetClaims,
  /// generatorTiers, subParcels, statsState, plotSoldCount) back to empty.
  /// Used before migrating to mainnet for a clean slate.
  resetAllData: () -> ();
  /// Admin: clear all player state for a clean test run (TESTNET_MODE only).
  resetTestState: () -> (ResetResult);
  /// Set a new admin principal. Guarded by current admin.
  setAdminPrincipal: (p: principal) -> ();
  setApprovedLiquidityCanister: (dexCanister: principal) ->
   (variant {
      err: text;
      ok;
    });
  setFrntrLedger: (canisterId: principal) -> ();
  setGameCanisterPrincipal: (p: text) -> ();
  setSelfPrincipal: () -> ();
  /// Update the treasury canister principal (admin only).
  setTreasuryPrincipal: (p: principal) -> ();
  /// Set a unique username (3-16 alphanumeric + underscore).
  setUsername: (username: text) -> (variant {
                                      err: text;
                                      ok;
                                    });
  /// Start a survey for a plot the caller owns.
  /// Deducts the survey cost in FRNTR (from local balance or ICRC-1 ledger) and
  /// records an in-progress survey record with startTime = now.
  /// Returns #err if the plot is not owned by the caller, if a survey is already
  /// in progress or completed, or if the caller has insufficient FRNTR.
  startSurvey: (plotId: text) -> (variant {
                                    err: text;
                                    ok: SurveyView;
                                  });
  /// Buy `count` plots in sequence (TESTNET_MODE only).
  stressBuyPlots: (count: nat) -> (StressTestResult);
  /// Rapidly mint `count` unowned plots (TESTNET_MODE only).
  stressMintPlots: (count: nat) -> (StressTestResult);
  /// Run `count` upgrade cycles across owned plots (TESTNET_MODE only).
  stressUpgradePlots: (count: nat) -> (StressTestResult);
  /// Testnet faucet: grants exactly 500 FRNTR per click.
  /// No cooldown, no rate limit. ICP is real and not simulated.
  testFaucet: () -> (variant {
                       err: text;
                       ok: text;
                     });
  /// Testnet faucet: grants 5000 FRNTR (500_000_000_000 e8s) + 5 ICP (500_000_000 e8s) per click.
  /// Transfers FRNTR via ICRC-1 ledger (if set) and 5 ICP via ICP ledger.
  /// Auto-creates a player record if one doesn't exist.
  /// No cooldown. TESTNET_MODE=true only.
  testFaucetV2: () -> (FaucetResult);
  updateAdminPrincipalAuth: (newPrincipal: text) -> ();
  /// Upgrade the generator tier for an owned plot.
  /// Deducts FRNTR cost from player balance, tracks burn, sends 0.075% liquidity tax to treasury.
  upgradeGenerator: (plotId: text) ->
   (variant {
      err: UpgradeError;
      ok: PlotUpgradesView;
    });
  withdrawLiquidityPot: (amountE8s: nat, recipient: principal) ->
   (variant {
      err: text;
      ok;
    });
}
