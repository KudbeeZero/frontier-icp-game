type ResourceType = 
 variant {
   Crystal;
   Fuel;
   Iron;
   RareEarth;
 };
type PlotId = nat;
type MineResult = 
 record {
   efficiency: float64;
   frntRate: float64;
   plotId: PlotId;
   resourceYields: vec record {
                         ResourceType;
                         float64;
                       };
 };
type CombatEvent = 
 record {
   atkPower: nat;
   attacker: principal;
   defPower: nat;
   fromPlot: nat;
   intercepted: bool;
   interceptorType: opt text;
   missileType: opt text;
   success: bool;
   timestamp: int;
   toPlot: nat;
 };
service : {
  assignInterceptor: (plotId: nat, interceptorType: text) -> ();
  getAdjacentPlots: (plotId: nat) -> (vec nat) query;
  getAdminPrincipal: () -> (text) query;
  getAssignedInterceptor: (plotId: nat) -> (opt text) query;
  getCombatLog: (limit: nat) -> (vec CombatEvent) query;
  /// Public leaderboard query: top players by FRNTR balance.
  getLeaderboard: (limit: nat) ->
   (vec
     record {
       frntBalance: nat;
       plotsOwned: nat;
       "principal": text;
       rank: nat;
       username: opt text;
     }) query;
  /// Returns global leaderboard and economy stats.
  getLeaderboardStats: () ->
   (record {
      activePlayers: nat;
      leaderboardPrizePool: nat;
      nextPayoutAt: nat;
      totalFRNTRBurned: nat;
      totalFRNTRMined: nat;
      totalPlotsOwned: nat;
    }) query;
  getPassiveIncome: (plotId: nat) -> (float64) query;
  getPlayerState: () ->
   (record {
      combatVictories: nat;
      crystal: nat;
      frntBalance: nat;
      fuel: nat;
      generatorTiersMap: vec record {
                               text;
                               nat;
                             };
      iron: nat;
      lastFaucetTime: opt int;
      ownedPlots: vec text;
      passiveIncomePerDay: float64;
      plotsOwned: nat;
      resourceBalances: vec record {
                              ResourceType;
                              float64;
                            };
      totalFRNTRBurned: float64;
      username: opt text;
    }) query;
  /// Returns the canonical ICP price (e8s) for a plot identified by its H3 index.
  getPlotPrice: (h3Index: text) -> (nat) query;
  /// Returns the tokenomics snapshot for display in the UNIVERSE menu.
  getTokenomics: () ->
   (record {
      burnedTotal: nat;
      currentCirculating: nat;
      dailyEmission: nat;
      emissionScheduleYears: nat;
      maxPlots: nat;
      mineableSupply: nat;
      plotCount: nat;
      preMinted: nat;
      totalSupply: nat;
    }) query;
  /// Query the current treasury canister principal.
  getTreasuryPrincipal: () -> (text) query;
  isSubParcelLocked: (plotId: nat) -> (bool) query;
  launchMissile: (fromPlotId: nat, toPlotId: nat, missileType: text) ->
   (variant {
      err: text;
      ok: text;
    });
  /// Mine resources from an owned plot.
  mineResources: (plotId: nat) -> (variant {
                                     err: text;
                                     ok: MineResult;
                                   });
  purchasePlot: (plotId: nat) -> (variant {
                                    err: text;
                                    ok: text;
                                  });
  /// Set a new admin principal. Guarded by current admin.
  setAdminPrincipal: (p: principal) -> ();
  /// Update the treasury canister principal (admin only).
  setTreasuryPrincipal: (p: principal) -> ();
  /// Set a unique username (3-16 alphanumeric + underscore).
  setUsername: (username: text) -> (variant {
                                      err: text;
                                      ok;
                                    });
  /// Testnet faucet: grants 1000 FRNTR, once per principal per 24 hours.
  testFaucet: () -> (variant {
                       err: text;
                       ok: text;
                     });
  updateAdminPrincipalAuth: (newPrincipal: text) -> ();
}
